# ==========================================================================
# BandUltra — Trial Request API
# Copy to `.env` and fill in. NEVER commit the filled-in file.
# ==========================================================================

NODE_ENV=development
PORT=4000

# Set to 1 when running behind nginx / an ALB / Heroku, so req.ip (and the
# rate limiter) reads the real client address from X-Forwarded-For.
TRUST_PROXY=

# --------------------------------------------------------------- Database --
# The trial_requests collection uses a UUID primary key. Email is stored as a
# plain non-unique attribute here — see src/models/TrialRequest.js.
MONGODB_URI=mongodb://127.0.0.1:27017/bandultra
MONGODB_DB_NAME=

# ------------------------------------------------------------------- CORS --
# Comma-separated allowlist of origins permitted to POST the form.
# REQUIRED in production; leave blank in development to allow any origin.
CORS_ORIGINS=https://bandultra.com,https://www.bandultra.com

# ------------------------------------------------- WhatsApp Cloud API ------
# Set to false to store leads without sending (useful before the Meta Business
# account is approved). When false, sends are recorded with status "skipped".
WHATSAPP_ENABLED=true

# Meta Graph API version, e.g. v22.0. Pin it; do not track "latest".
WHATSAPP_GRAPH_API_VERSION=v22.0

# WhatsApp Manager -> API Setup -> "Phone number ID" (a numeric id, NOT the
# phone number itself).
WHATSAPP_PHONE_NUMBER_ID=

# System User permanent access token with whatsapp_business_messaging scope.
# A temporary token from the dashboard expires in 24h and is not usable in
# production. Rotate on a schedule; this is the highest-value secret here.
WHATSAPP_ACCESS_TOKEN=

# Name of the message template to send. Must be APPROVED in WhatsApp Manager.
WHATSAPP_TEMPLATE_NAME=free_trial_booking_confirmation

# The language the template was APPROVED under. In WhatsApp Manager "English"
# is `en` and "English (US)" is `en_US` — Meta treats them as two DIFFERENT
# templates, and the wrong one fails with error 132001, exactly as if the
# template did not exist. If you are not certain which you picked, run:
#     npm run whatsapp:verify
# which reads the answer from Meta and prints the line to paste here.
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# The branded template declares one variable, {{1}} = institute name.
# Set false only for a template with no variables (e.g. hello_world);
# a count mismatch is rejected with error 132000.
WHATSAPP_TEMPLATE_HAS_BODY_PARAMS=true

# On a 132001, retry once with the sibling locale (en <-> en_US) and log which
# one actually worked. Turn off once the language above is confirmed correct.
WHATSAPP_TEMPLATE_LANGUAGE_FALLBACK=true

# Needed ONLY by `npm run whatsapp:verify`, not at runtime. WhatsApp Manager →
# API Setup lists it beside the Phone number ID.
WHATSAPP_BUSINESS_ACCOUNT_ID=

# To fall back to Meta's sample template while the branded one is in review:
#   WHATSAPP_TEMPLATE_NAME=hello_world
#   WHATSAPP_TEMPLATE_LANGUAGE=en_US
#   WHATSAPP_TEMPLATE_HAS_BODY_PARAMS=false

WHATSAPP_TIMEOUT_MS=10000
WHATSAPP_MAX_ATTEMPTS=4
WHATSAPP_RETRY_BASE_DELAY_MS=1000

# --------------------------------------------------------- Abuse controls --
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10

# Repeat submissions from the same WhatsApp number inside this window are
# treated as a duplicate click, not a new lead.
DUPLICATE_WINDOW_MS=600000

LOG_LEVEL=info
